def put(scr, y, x, text, attr=0):
    h, w = scr.getmaxyx()
    if y < 0 or y >= h or x < 0 or x >= w:
        return
    text = text[: w - x]
    try:
        scr.addstr(y, x, text, attr)
    except curses.error:
        pass  # jobb alsó cella írása hibát dob, de kiírja


def clean(s):
    return "".join(ch if ch >= " " or ch == "\t" else "·" for ch in s)


def disp_col(line, idx):
    col = 0
    for ch in line[:idx]:
        col += TAB - col % TAB if ch == "\t" else 1
    return col


def idx_from_col(line, target):
    col = 0
    for i, ch in enumerate(line):
        col += TAB - col % TAB if ch == "\t" else 1
        if col > target:
            return i
    return len(line)


def human(n):
    for u in ("B", "K", "M", "G", "T"):
        if n < 1024:
            return f"{n:.0f}{u}" if u == "B" else f"{n:.1f}{u}"
        n /= 1024
    return f"{n:.1f}P"


def unique_path(dst):
    if not os.path.lexists(dst):
        return dst
    base, ext = os.path.splitext(dst)
    i = 1
    while os.path.lexists(f"{base}_{i}{ext}"):
        i += 1
    return f"{base}_{i}{ext}"


def split_delim(s, d):
    parts, cur, i = [], "", 0
    while i < len(s):
        ch = s[i]
        if ch == "\\" and i + 1 < len(s):
            cur += d if s[i + 1] == d else ch + s[i + 1]
            i += 2
            continue
        if ch == d:
            parts.append(cur)
            cur = ""
        else:
            cur += ch
        i += 1
    parts.append(cur)
    return parts


def load_text(path):
    with open(path, "rb") as f:
        data = f.read()
    if b"\0" in data[:8192]:
        raise ValueError("bináris fájl, nem szerkeszthető")
    try:
        text, enc = data.decode("utf-8"), "utf-8"
    except UnicodeDecodeError:
        text, enc = data.decode("iso-8859-2"), "iso-8859-2"
    nl = "\r\n" if "\r\n" in text else "\n"
    if nl == "\r\n":
        text = text.replace("\r\n", "\n")
    trailing = text.endswith("\n") or text == ""
    if text.endswith("\n"):
        text = text[:-1]
    return text.split("\n"), enc, nl, trailing


def save_text(path, lines, enc, nl, trailing):
    path = os.path.realpath(path)
    data = (nl.join(lines) + (nl if trailing else "")).encode(enc, errors="replace")
    d = os.path.dirname(path)
    try:
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".nanger-")
    except OSError:
        with open(path, "wb") as f:  # nincs írási jog a mappára: közvetlen írás
            f.write(data)
        return
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        if os.path.exists(path):
            shutil.copymode(path, tmp)
        else:
            um = os.umask(0)
            os.umask(um)
            os.chmod(tmp, 0o666 & ~um)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def set_system_clipboard(text):
    cmds = []
    if os.environ.get("WAYLAND_DISPLAY"):
        cmds.append(["wl-copy"])
    if os.environ.get("DISPLAY"):
        cmds += [["xclip", "-selection", "clipboard"], ["xsel", "-b", "-i"]]
    for cmd in cmds:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), timeout=1,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
            return


