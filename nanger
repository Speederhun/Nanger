def init_colors():
    for k in ("exe", "link", "com", "str", "num", "kw", "err", "tag"):
        A[k] = curses.A_NORMAL
    A["dir"] = curses.A_BOLD
    A["title"] = curses.A_REVERSE
    A["key"] = curses.A_REVERSE
    A["match"] = curses.A_UNDERLINE
    A["ln"] = curses.A_DIM
    A["err"] = curses.A_BOLD
    if not curses.has_colors():
        return
    try:
        curses.start_color()
    except curses.error:
        return
    bg = -1
    try:
        curses.use_default_colors()
    except curses.error:
        bg = curses.COLOR_BLACK
    spec = {
        "dir": (curses.COLOR_BLUE, bg, curses.A_BOLD),
        "exe": (curses.COLOR_GREEN, bg, curses.A_BOLD),
        "link": (curses.COLOR_CYAN, bg, 0),
        "com": (curses.COLOR_GREEN, bg, 0),
        "str": (curses.COLOR_YELLOW, bg, 0),
        "num": (curses.COLOR_CYAN, bg, 0),
        "kw": (curses.COLOR_MAGENTA, bg, curses.A_BOLD),
        "match": (curses.COLOR_BLACK, curses.COLOR_YELLOW, 0),
        "err": (curses.COLOR_RED, bg, curses.A_BOLD),
        "tag": (curses.COLOR_YELLOW, bg, curses.A_BOLD),
    }
    for i, (name, (fg, b, extra)) in enumerate(spec.items(), start=1):
        try:
            curses.init_pair(i, fg, b)
            A[name] = curses.color_pair(i) | extra
        except curses.error:
            pass


