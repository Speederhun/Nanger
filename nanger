class Browser:
    def __init__(self, app, path):
        self.app = app
        self.cwd = os.path.abspath(os.path.expanduser(path))
        self.hidden = False
        self.sel = self.top = 0
        self.entries = []
        self.tagged = set()
        self.marked = None  # (útvonalak, "copy" | "cut")
        self.last_search = ""
        self._pv_key = None
        self._pv = []
        self.refresh()

    def listdir(self, d):
        try:
            names = os.listdir(d)
        except OSError:
            return None
        if not self.hidden:
            names = [n for n in names if not n.startswith(".")]
        return sorted(names, key=lambda n: (not os.path.isdir(os.path.join(d, n)), n.casefold()))

    def refresh(self, select=None):
        e = self.listdir(self.cwd)
        if e is None:
            self.app.error("A mappa nem olvasható")
            e = []
        self.entries = e
        if select in e:
            self.sel = e.index(select)
        self.sel = max(0, min(self.sel, len(e) - 1))
        self._pv_key = None

    def cd(self, path, select=None):
        path = os.path.abspath(os.path.expanduser(path))
        if not os.path.isdir(path):
            self.app.error(f"Nem mappa: {path}")
            return
        try:
            os.listdir(path)
        except OSError as e:
            self.app.error(f"Nem nyitható meg: {e.strerror}")
            return
        self.cwd = path
        self.sel = self.top = 0
        self.refresh(select)

    def current(self):
        if not self.entries:
            return None
        return os.path.join(self.cwd, self.entries[self.sel])

    def targets(self):
        if self.tagged:
            return sorted(self.tagged)
        cur = self.current()
        return [cur] if cur else []

    def handle(self, k):
        app = self.app
        n = len(self.entries)
        cur = self.current()
        page = max(1, app.text_height() - 1)
        if k in (curses.KEY_UP, "k"):
            self.sel = max(0, self.sel - 1)
        elif k in (curses.KEY_DOWN, "j"):
            self.sel = min(max(0, n - 1), self.sel + 1)
        elif k == curses.KEY_PPAGE:
            self.sel = max(0, self.sel - page)
        elif k == curses.KEY_NPAGE:
            self.sel = min(max(0, n - 1), self.sel + page)
        elif k in (curses.KEY_HOME, "g"):
            self.sel = 0
        elif k in (curses.KEY_END, "G"):
            self.sel = max(0, n - 1)
        elif k in (curses.KEY_LEFT, "h") or k in BACKSPACE:
            parent = os.path.dirname(self.cwd)
            if parent != self.cwd:
                self.cd(parent, os.path.basename(self.cwd))
        elif k in (curses.KEY_RIGHT, "l") or k in ENTER:
            if cur and os.path.isdir(cur):
                self.cd(cur)
            elif cur:
                app.open_editor(cur)
        elif k == "e":
            if cur and not os.path.isdir(cur):
                app.open_editor(cur)
        elif k == "n":
            name = app.prompt("Új fájl neve: ")
            if name:
                app.open_editor(os.path.join(self.cwd, os.path.expanduser(name)))
        elif k == "N":
            name = app.prompt("Új mappa neve: ")
            if name:
                try:
                    os.makedirs(os.path.join(self.cwd, name))
                    self.refresh(name.split("/")[0])
                except OSError as e:
                    app.error(f"Nem sikerült: {e.strerror}")
        elif k == "r":
            if cur:
                old = os.path.basename(cur)
                name = app.prompt("Átnevezés: ", old)
                if name and name != old:
                    dst = os.path.join(self.cwd, name)
                    if os.path.lexists(dst):
                        app.error("Már létezik ilyen nevű elem")
                    else:
                        try:
                            os.rename(cur, dst)
                            self.tagged.discard(cur)
                            self.refresh(name)
                        except OSError as e:
                            app.error(f"Nem sikerült: {e.strerror}")
        elif k in ("D", curses.KEY_DC):
            self.delete()
        elif k == " ":
            if cur:
                self.tagged ^= {cur}
                self.sel = min(max(0, n - 1), self.sel + 1)
        elif k == ESC:
            self.tagged.clear()
        elif k in ("y", "x"):
            t = self.targets()
            if t:
                self.marked = (t, "copy" if k == "y" else "cut")
                self.tagged.clear()
                verb = "másolásra" if k == "y" else "kivágásra"
                app.info(f"{len(t)} elem kijelölve {verb} — menj a célmappába és nyomd meg: p")
        elif k == "p":
            self.paste()
        elif k == ".":
            self.hidden = not self.hidden
            self.refresh(os.path.basename(cur) if cur else None)
        elif k == "/":
            t = app.prompt("Keresés név alapján: ", self.last_search)
            if t:
                self.last_search = t
                low = t.casefold()
                for i in range(1, n + 1):
                    j = (self.sel + i) % n
                    if low in self.entries[j].casefold():
                        self.sel = j
                        break
                else:
                    app.error(f"Nincs találat: {t}")
        elif k == "c":
            p = app.prompt("Ugrás ide: ", self.cwd)
            if p:
                self.cd(p if os.path.isabs(os.path.expanduser(p)) else os.path.join(self.cwd, p))
        elif k == "~":
            self.cd(os.path.expanduser("~"))
        elif k == "S":
            app.shell(None, self.cwd)
            self.refresh(os.path.basename(cur) if cur else None)
        elif k == "!":
            c = app.prompt("Parancs: ", "", app.cmd_history)
            if c:
                app.shell(c, self.cwd)
                self.refresh(os.path.basename(cur) if cur else None)
        elif k in ("q", C("q")):
            app.running = False
        elif k in ("?", curses.KEY_F1):
            app.show_help(BROWSER_HELP_TEXT)

    def delete(self):
        t = self.targets()
        if not t:
            return
        label = os.path.basename(t[0]) + ("/" if os.path.isdir(t[0]) else "")
        if len(t) > 1:
            label = f"{len(t)} elemet"
        a = self.app.ask(f"Biztosan törlöd: {label}? (i = igen, n = nem) ")
        if a not in ("i", "y"):
            self.app.info("Törlés megszakítva")
            return
        for p in t:
            try:
                if os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p)
                else:
                    os.remove(p)
            except OSError as e:
                self.app.error(f"Nem törölhető: {os.path.basename(p)} ({e.strerror})")
                break
        else:
            self.app.info(f"Törölve: {label}")
        self.tagged.clear()
        self.refresh()

    def paste(self):
        if not self.marked:
            self.app.error("Nincs mit beilleszteni (y = másol, x = kivág)")
            return
        paths, mode = self.marked
        last = None
        for src in paths:
            if not os.path.lexists(src):
                continue
            if mode == "cut" and os.path.dirname(src) == self.cwd:
                continue
            if os.path.isdir(src) and (self.cwd + os.sep).startswith(src + os.sep):
                self.app.error("Mappa nem másolható önmagába")
                continue
            dst = unique_path(os.path.join(self.cwd, os.path.basename(src)))
            try:
                if mode == "cut":
                    shutil.move(src, dst)
                elif os.path.isdir(src) and not os.path.islink(src):
                    shutil.copytree(src, dst, symlinks=True)
                else:
                    shutil.copy2(src, dst, follow_symlinks=False)
                last = os.path.basename(dst)
            except OSError as e:
                self.app.error(f"Hiba: {os.path.basename(src)} ({e.strerror or e})")
                break
        if mode == "cut":
            self.marked = None
        self.refresh(last)
        if last:
            self.app.info("Beillesztve")

    # ---- rajzolás
    def entry_attr(self, p):
        if os.path.islink(p):
            return A["link"]
        if os.path.isdir(p):
            return A["dir"]
        if os.access(p, os.X_OK):
            return A["exe"]
        return 0

    def draw_list(self, scr, x, width, d, ents, sel, top, th, active):
        for r in range(th):
            i = top + r
            if i >= len(ents):
                break
            name = ents[i]
            p = os.path.join(d, name)
            isdir = os.path.isdir(p)
            attr = self.entry_attr(p)
            mark = "*" if p in self.tagged else " "
            if p in self.tagged:
                attr = A["tag"]
            label = mark + clean(name) + ("/" if isdir else "")
            size = ""
            if active and not isdir:
                try:
                    size = human(os.lstat(p).st_size) + " "
                except OSError:
                    pass
            room = width - len(size)
            text = (label[:room].ljust(room) + size) if room > 4 else label[:width].ljust(width)
            if i == sel:
                attr |= curses.A_REVERSE
            put(scr, 1 + r, x, text, attr)

    def preview(self, p, th):
        try:
            st = os.stat(p)
        except OSError:
            return [("[nem elérhető]", A["err"])]
        key = (p, st.st_mtime, th, self.hidden)
        if key == self._pv_key:
            return self._pv
        if os.path.isdir(p):
            ents = self.listdir(p)
            if ents is None:
                out = [("[nincs jogosultság]", A["err"])]
            elif not ents:
                out = [("(üres mappa)", A["ln"])]
            else:
                out = [(" " + clean(e) + ("/" if os.path.isdir(os.path.join(p, e)) else ""),
                        self.entry_attr(os.path.join(p, e))) for e in ents[:th]]
        else:
            try:
                with open(p, "rb") as f:
                    data = f.read(64 * 1024)
                if b"\0" in data[:8192]:
                    out = [(f"[bináris fájl, {human(st.st_size)}]", A["ln"])]
                else:
                    text = data.decode("utf-8", errors="replace").replace("\r", "")
                    out = [(clean(l.expandtabs(TAB)), 0) for l in text.split("\n")[:th]]
                    if not data:
                        out = [("(üres fájl)", A["ln"])]
            except OSError as e:
                out = [(f"[nem olvasható: {e.strerror}]", A["err"])]
        self._pv_key, self._pv = key, out
        return out

    def draw(self, scr, h, w):
        th = h - 4
        n = len(self.entries)
        if self.sel < self.top:
            self.top = self.sel
        elif self.sel >= self.top + th:
            self.top = self.sel - th + 1
        w1 = max(10, w // 6)
        w2 = max(20, (w * 2) // 5)
        w3 = w - w1 - w2 - 2
        home = os.path.expanduser("~")
        shown = "~" + self.cwd[len(home):] if self.cwd.startswith(home) else self.cwd
        put(scr, 0, 0, " " * w, A["title"])
        put(scr, 0, 0, f" nanger │ {shown}", A["title"])
        parent = os.path.dirname(self.cwd)
        if parent != self.cwd:
            pents = self.listdir(parent) or []
            base = os.path.basename(self.cwd)
            pidx = pents.index(base) if base in pents else 0
            ptop = max(0, min(pidx - th // 2, len(pents) - th))
            self.draw_list(scr, 0, w1, parent, pents, pidx, ptop, th, False)
        for r in range(th):
            put(scr, 1 + r, w1, "│", A["ln"])
            put(scr, 1 + r, w1 + 1 + w2, "│", A["ln"])
        if n:
            self.draw_list(scr, w1 + 1, w2, self.cwd, self.entries, self.sel, self.top, th, True)
            if w3 > 3:
                for r, (text, at) in enumerate(self.preview(self.current(), th)):
                    put(scr, 1 + r, w1 + w2 + 2, text[:w3], at)
        else:
            put(scr, 1, w1 + 2, "(üres mappa — n: új fájl)", A["ln"])
        if not self.app.msg and n:
            cur = self.current()
            try:
                st = os.lstat(cur)
                import stat as _st
                import time as _t
                info = (f" {_st.filemode(st.st_mode)}  {human(st.st_size)}  "
                        f"{_t.strftime('%Y-%m-%d %H:%M', _t.localtime(st.st_mtime))}"
                        f"   {self.sel + 1}/{n}")
                if self.tagged:
                    info += f"   {len(self.tagged)} megjelölve"
                if self.marked:
                    info += f"   vágólapon: {len(self.marked[0])}"
                put(scr, h - 3, 0, info, A["ln"])
            except OSError:
                pass
        draw_help(scr, h - 2, BROWSER_HELP1, w)
        draw_help(scr, h - 1, BROWSER_HELP2, w)
        return None


# ---------------------------------------------------------- alkalmazás

class App:
    def __init__(self, scr, target):
        self.scr = scr
        self.msg = ""
        self.msg_err = False
        self.clip = ("", False)
        self.running = True
        self.queue = deque()
        self.recording = None
        self.macro = []
        self.cmd_history = []
        self.editor = None
        self.only_file = False
        target = os.path.abspath(os.path.expanduser(target))
        if os.path.isdir(target):
            self.browser = Browser(self, target)
        else:
            d = os.path.dirname(target)
            self.browser = Browser(self, d if os.path.isdir(d) else os.getcwd())
            self.only_file = True
            self.open_editor(target)
            if self.editor is None:
                self.only_file = False

    # ---- üzenetek
    def info(self, m):
        self.msg, self.msg_err = m, False

    def error(self, m):
        self.msg, self.msg_err = m, True
        curses.beep()

    def text_height(self):
        return self.scr.getmaxyx()[0] - 4

    def input_pending(self):
        try:
            return bool(select.select([sys.stdin], [], [], 0)[0])
        except (OSError, ValueError):
            return False

    def set_clip(self, text, linewise):
        self.clip = (text, linewise)
        set_system_clipboard(text)

    # ---- nézetek
    def open_editor(self, path):
        try:
            self.editor = Editor(self, path)
        except (ValueError, OSError) as e:
            self.error(f"Nem nyitható meg: {getattr(e, 'strerror', None) or e}")

    def close_editor(self, path):
        self.editor = None
        if self.only_file:
            self.running = False
            return
        if path and os.path.dirname(path) == self.browser.cwd:
            self.browser.refresh(os.path.basename(path))
        else:
            self.browser.refresh()

    # ---- billentyűzet
    def getkey(self):
        if self.queue:
            return self.queue.popleft()
        try:
            k = self.scr.get_wch()
        except curses.error:
            return None
        except KeyboardInterrupt:
            return C("c")
        if isinstance(k, str) and len(k) == 1 and (ord(k) < 32 or ord(k) == 127):
            k = ord(k)
        if k == ESC:
            k = self.decode_escape()
        if self.recording is not None and k not in (curses.KEY_F5, curses.KEY_F6,
                                                    curses.KEY_RESIZE):
            self.recording.append(k)
        return k

    def decode_escape(self):
        """Olyan escape-szekvenciák felismerése, amelyeket a terminfo nem ismer
        (pl. tmux / egyes terminálok a CSI-formát küldik)."""
        self.scr.nodelay(True)
        seq = ""
        try:
            for _ in range(8):
                try:
                    ch = self.scr.get_wch()
                except curses.error:
                    break
                if not isinstance(ch, str):
                    break
                seq += ch
                if ch.isalpha() or ch == "~":
                    break
        finally:
            self.scr.nodelay(False)
        if not seq:
            return ESC
        return ESCAPES.get(seq, ESC)

    def play_macro(self, times=1):
        if self.recording is not None:
            self.error("Felvétel közben nem játszható le (F5 = leállítás)")
        elif not self.macro:
            self.error("Nincs rögzített makró (F5 = felvétel)")
        else:
            self.queue.extend(self.macro * max(1, min(times, 10000)))

    def run(self):
        while self.running:
            if not self.queue:
                self.draw()
            k = self.getkey()
            if k is None or k == curses.KEY_RESIZE:
                continue
            self.msg = ""
            if k == curses.KEY_F5:
                if self.recording is None:
                    self.recording = []
                    self.info("Makró felvétel… (F5 = leállítás)")
                else:
                    self.macro, self.recording = self.recording, None
                    self.info(f"Makró rögzítve ({len(self.macro)} billentyű) — F6 = lejátszás")
            elif k == curses.KEY_F6:
                self.play_macro()
            else:
                (self.editor or self.browser).handle(k)

    # ---- képernyő
    def draw(self, overlay=None):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 8 or w < 30:
            put(scr, 0, 0, "Túl kicsi az ablak")
            scr.refresh()
            return
        cursor = (self.editor or self.browser).draw(scr, h, w)
        if overlay:
            text, cur = overlay
            start = max(0, cur - (w - 2))
            put(scr, h - 3, 0, " " * (w - 1))
            put(scr, h - 3, 0, text[start:start + w - 1], curses.A_BOLD)
            cursor = (h - 3, cur - start)
        elif self.msg:
            put(scr, h - 3, 0, " " * (w - 1))
            put(scr, h - 3, 0, self.msg[: w - 1], A["err"] if self.msg_err else curses.A_BOLD)
        try:
            if cursor:
                curses.curs_set(1)
                scr.move(max(0, min(cursor[0], h - 1)), max(0, min(cursor[1], w - 1)))
            else:
                curses.curs_set(0)
        except curses.error:
            pass
        scr.refresh()

    def prompt(self, label, default="", history=None):
        buf = list(default)
        pos = len(buf)
        hi = len(history) if history is not None else 0
        while True:
            if not self.queue:
                self.draw(overlay=(label + "".join(buf), len(label) + pos))
            k = self.getkey()
            if k is None or k == curses.KEY_RESIZE:
                continue
            if k in ENTER:
                res = "".join(buf)
                if history is not None and res and (not history or history[-1] != res):
                    history.append(res)
                self.msg = ""
                return res
            if k in (ESC, C("c"), C("q")):
                self.msg = ""
                return None
            if k in BACKSPACE:
                if pos:
                    del buf[pos - 1]
                    pos -= 1
            elif k == curses.KEY_DC:
                if pos < len(buf):
                    del buf[pos]
            elif k == curses.KEY_LEFT:
                pos = max(0, pos - 1)
            elif k == curses.KEY_RIGHT:
                pos = min(len(buf), pos + 1)
            elif k in (curses.KEY_HOME, C("a")):
                pos = 0
            elif k in (curses.KEY_END, C("e")):
                pos = len(buf)
            elif k == C("u"):
                buf, pos = [], 0
            elif k in (curses.KEY_UP, curses.KEY_DOWN) and history:
                hi = max(0, hi - 1) if k == curses.KEY_UP else min(len(history), hi + 1)
                buf = list(history[hi]) if hi < len(history) else []
                pos = len(buf)
            elif isinstance(k, str):
                buf[pos:pos] = list(k)
                pos += len(k)

    def ask(self, label):
        while True:
            if not self.queue:
                self.draw(overlay=(label, len(label)))
            k = self.getkey()
            if k is None or k == curses.KEY_RESIZE:
                continue
            self.msg = ""
            if isinstance(k, str):
                return k.lower()
            return None

    def show_help(self, text):
        lines = text.split("\n")
        top = 0
        while True:
            scr = self.scr
            scr.erase()
            h, w = scr.getmaxyx()
            for r, line in enumerate(lines[top:top + h]):
                put(scr, r, 0, line, curses.A_BOLD if line[:1].isupper() else 0)
            try:
                curses.curs_set(0)
            except curses.error:
                pass
            scr.refresh()
            k = self.getkey()
            if k in (curses.KEY_DOWN, "j", curses.KEY_NPAGE):
                top = min(max(0, len(lines) - h), top + (1 if k != curses.KEY_NPAGE else h))
            elif k in (curses.KEY_UP, "k", curses.KEY_PPAGE):
                top = max(0, top - (1 if k != curses.KEY_PPAGE else h))
            elif k not in (None, curses.KEY_RESIZE):
                return

    def shell(self, cmd, cwd):
        curses.def_prog_mode()
        curses.endwin()
        try:
            if cmd:
                print(f"$ {cmd}", flush=True)
                subprocess.call(cmd, shell=True, cwd=cwd)
                input("\n[Enter = vissza a nangerbe] ")
            else:
                sh = os.environ.get("SHELL", "/bin/sh")
                print("nanger: shell ebben a mappában — írd be: exit a visszatéréshez", flush=True)
                subprocess.call([sh], cwd=cwd)
        except (KeyboardInterrupt, EOFError):
            pass
        curses.reset_prog_mode()
        self.scr.clear()
        self.scr.refresh()


USAGE = f"""nanger {VERSION} — fájlkezelő és szerkesztő (ranger + nano + vim)

Használat:
  nanger              fájlkezelő az aktuális mappában
  nanger MAPPA        fájlkezelő a megadott mappában
  nanger FÁJL         a fájl azonnali szerkesztése

  -h, --help          ez a súgó
  -v, --version       verzió

A programon belül F1 (szerkesztő) vagy ? (fájlkezelő) mutatja a billentyűket.
"""


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    if args and args[0] in ("-v", "--version"):
        print(f"nanger {VERSION}")
        return 0
    if len(args) > 1:
        print("Egyszerre egy mappát vagy fájlt adj meg.\n\n" + USAGE, file=sys.stderr)
        return 2
    target = args[0] if args else "."
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("nanger: terminálban kell futtatni", file=sys.stderr)
        return 1

    def run(scr):
        curses.raw()
        curses.noecho()
        scr.keypad(True)
        init_colors()
        App(scr, target).run()

    curses.wrapper(run)
    return 0


if __name__ == "__main__":
    sys.exit(main())
