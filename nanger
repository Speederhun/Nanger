class Editor:
    def __init__(self, app, path):
        self.app = app
        self.path = path
        self.enc, self.nl, self.trailing = "utf-8", "\n", True
        self.lines = [""]
        if path and os.path.exists(path):
            self.lines, self.enc, self.nl, self.trailing = load_text(path)
        self.cy = self.cx = self.top = self.left = self.want = 0
        self.modified = False
        self.undo, self.redo = [], []
        self.typing = False
        self.anchor = None
        self.sticky = False
        self.numbers = True
        self.search = ""
        self.last_cut = False
        self.use_tabs = any(l.startswith("\t") for l in self.lines[:1000])
        self.set_syntax()

    def set_syntax(self):
        ext = os.path.splitext(self.path or "")[1].lower()
        self.ctok = COMMENTS.get(ext, "#")
        self.hl = ext not in PLAIN

    def dir(self):
        return os.path.dirname(self.path) if self.path else self.app.browser.cwd

    # ---- állapot
    def push(self):
        self.undo.append((self.lines[:], self.cy, self.cx))
        if len(self.undo) > 400:
            del self.undo[0]
        self.redo.clear()

    def begin(self, group=False):
        if not (group and self.typing):
            self.push()
        self.typing = group
        self.modified = True

    def replace_sel_begin(self, group):
        if self.anchor is not None:
            self.push()
            self.delete_sel()
            self.typing = group
            self.modified = True
        else:
            self.begin(group)

    def clamp(self):
        self.cy = max(0, min(self.cy, len(self.lines) - 1))
        self.cx = max(0, min(self.cx, len(self.lines[self.cy])))

    def set_want(self):
        self.want = disp_col(self.lines[self.cy], self.cx)

    def do_undo(self):
        if not self.undo:
            self.app.info("Nincs mit visszavonni")
            return
        self.redo.append((self.lines[:], self.cy, self.cx))
        self.lines, self.cy, self.cx = self.undo.pop()
        self.anchor = None
        self.modified = True
        self.clamp()

    def do_redo(self):
        if not self.redo:
            self.app.info("Nincs mit újra végrehajtani")
            return
        self.undo.append((self.lines[:], self.cy, self.cx))
        self.lines, self.cy, self.cx = self.redo.pop()
        self.anchor = None
        self.modified = True
        self.clamp()

    # ---- kijelölés
    def sel_range(self):
        if self.anchor is None:
            return None
        a, b = self.anchor, (self.cy, self.cx)
        if a == b:
            return None
        return (a, b) if a < b else (b, a)

    def sel_text(self, r):
        (y1, x1), (y2, x2) = r
        L = self.lines
        if y1 == y2:
            return L[y1][x1:x2]
        return "\n".join([L[y1][x1:]] + L[y1 + 1:y2] + [L[y2][:x2]])

    def delete_sel(self):
        r = self.sel_range()
        self.anchor = None
        self.sticky = False
        if not r:
            return
        (y1, x1), (y2, x2) = r
        self.lines[y1:y2 + 1] = [self.lines[y1][:x1] + self.lines[y2][x2:]]
        self.cy, self.cx = y1, x1
        self.set_want()

    def sel_lines(self, default_all):
        r = self.sel_range()
        if r:
            (y1, _), (y2, x2) = r
            if x2 == 0 and y2 > y1:
                y2 -= 1
            return y1, y2
        if default_all:
            return 0, len(self.lines) - 1
        return self.cy, self.cy

    def insert_text(self, text):
        parts = text.split("\n")
        line = self.lines[self.cy]
        before, after = line[:self.cx], line[self.cx:]
        if len(parts) == 1:
            self.lines[self.cy] = before + text + after
            self.cx += len(text)
        else:
            new = [before + parts[0]] + parts[1:-1] + [parts[-1] + after]
            self.lines[self.cy:self.cy + 1] = new
            self.cy += len(parts) - 1
            self.cx = len(parts[-1])
        self.set_want()

    # ---- billentyűk
    def handle(self, k):
        if not (isinstance(k, str) or k in ENTER):
            self.typing = False
        cut_chain = False
        if k in SHIFT_MOVES:
            if self.anchor is None:
                self.anchor = (self.cy, self.cx)
                self.sticky = False
            self.move(SHIFT_MOVES[k])
        elif k in MOVES:
            if self.anchor is not None and not self.sticky:
                self.anchor = None
            self.move(k)
        elif isinstance(k, str):
            self.insert_char(k)
        elif k in ENTER:
            self.newline()
        elif k in BACKSPACE:
            self.backspace()
        elif k == curses.KEY_DC:
            self.delete()
        elif k == 9:
            self.tab()
        elif k == curses.KEY_BTAB:
            self.indent(-1)
        elif k == C("s"):
            self.save()
        elif k == C("o"):
            self.save_as()
        elif k in (C("q"), C("x")):
            self.close()
        elif k == C("f"):
            self.find_prompt()
        elif k in (C("n"), curses.KEY_F3):
            self.find_next()
        elif k == C("r"):
            self.replace_prompt()
        elif k == C("g"):
            self.goto_prompt()
        elif k in (C("p"), curses.KEY_F2):
            c = self.app.prompt(":", "", self.app.cmd_history)
            if c:
                self.run_command(c)
        elif k == C("z"):
            self.do_undo()
        elif k == C("y"):
            self.do_redo()
        elif k == C("b"):
            if self.anchor is None:
                self.anchor, self.sticky = (self.cy, self.cx), True
                self.app.info("Kijelölés-mód: mozogj a nyilakkal, majd ^C / ^K")
            else:
                self.anchor, self.sticky = None, False
        elif k == C("a"):
            self.anchor, self.sticky = (0, 0), True
            self.cy = len(self.lines) - 1
            self.cx = len(self.lines[-1])
        elif k == C("c"):
            self.copy()
        elif k == C("k"):
            self.cut()
            cut_chain = True
        elif k in (C("v"), C("u")):
            self.paste()
        elif k == C("d"):
            self.begin()
            self.lines.insert(self.cy + 1, self.lines[self.cy])
            self.cy += 1
        elif k == C("l"):
            self.numbers = not self.numbers
        elif k == ESC:
            self.anchor, self.sticky = None, False
        elif k == curses.KEY_F1:
            self.app.show_help(EDITOR_HELP_TEXT)
        self.last_cut = cut_chain
        self.clamp()

    def move(self, k):
        L = self.lines
        page = max(1, self.app.text_height() - 1)
        if k in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_PPAGE, curses.KEY_NPAGE):
            d = {curses.KEY_UP: -1, curses.KEY_DOWN: 1,
                 curses.KEY_PPAGE: -page, curses.KEY_NPAGE: page}[k]
            self.cy = max(0, min(len(L) - 1, self.cy + d))
            self.cx = idx_from_col(L[self.cy], self.want)
            return
        if k == curses.KEY_LEFT:
            if self.cx > 0:
                self.cx -= 1
            elif self.cy > 0:
                self.cy -= 1
                self.cx = len(L[self.cy])
        elif k == curses.KEY_RIGHT:
            if self.cx < len(L[self.cy]):
                self.cx += 1
            elif self.cy < len(L) - 1:
                self.cy += 1
                self.cx = 0
        elif k == curses.KEY_HOME:
            line = L[self.cy]
            ind = len(line) - len(line.lstrip(" \t"))
            self.cx = 0 if self.cx == ind else ind
        elif k == curses.KEY_END:
            self.cx = len(L[self.cy])
        self.set_want()

    def insert_char(self, ch):
        self.replace_sel_begin(True)
        line = self.lines[self.cy]
        self.lines[self.cy] = line[:self.cx] + ch + line[self.cx:]
        self.cx += len(ch)
        self.set_want()
        if ch in " \t":
            self.typing = False  # szavanként visszavonható

    def newline(self):
        self.replace_sel_begin(True)
        pasting = self.app.input_pending()
        line = self.lines[self.cy]
        before, after = line[:self.cx], line[self.cx:]
        indent = ""
        if not pasting:
            indent = re.match(r"[ \t]*", before).group(0)
            if before.rstrip().endswith((":", "{", "(", "[")):
                indent += "\t" if self.use_tabs else " " * TAB
            after = after.lstrip(" \t")
        self.lines[self.cy] = before
        self.lines.insert(self.cy + 1, indent + after)
        self.cy += 1
        self.cx = len(indent)
        self.set_want()

    def backspace(self):
        if self.anchor is not None and self.sel_range():
            self.push()
            self.delete_sel()
            self.modified = True
            return
        self.anchor = None
        if self.cx == 0 and self.cy == 0:
            return
        self.begin()
        L = self.lines
        if self.cx > 0:
            line = L[self.cy]
            n = 1
            if not self.use_tabs and line[:self.cx].strip() == "" and self.cx % TAB == 0:
                n = TAB
            L[self.cy] = line[:self.cx - n] + line[self.cx:]
            self.cx -= n
        else:
            self.cx = len(L[self.cy - 1])
            L[self.cy - 1] += L[self.cy]
            del L[self.cy]
            self.cy -= 1
        self.set_want()

    def delete(self):
        if self.anchor is not None and self.sel_range():
            self.push()
            self.delete_sel()
            self.modified = True
            return
        self.anchor = None
        L = self.lines
        if self.cx < len(L[self.cy]):
            self.begin()
            L[self.cy] = L[self.cy][:self.cx] + L[self.cy][self.cx + 1:]
        elif self.cy < len(L) - 1:
            self.begin()
            L[self.cy] += L[self.cy + 1]
            del L[self.cy + 1]

    def tab(self):
        r = self.sel_range()
        if r and r[0][0] != r[1][0]:
            self.indent(1)
            return
        unit = "\t" if self.use_tabs else " " * (TAB - disp_col(self.lines[self.cy], self.cx) % TAB)
        self.replace_sel_begin(True)
        self.insert_text(unit)

    def indent(self, d):
        y1, y2 = self.sel_lines(False)
        unit = "\t" if self.use_tabs else " " * TAB
        self.begin()
        for y in range(y1, y2 + 1):
            line = self.lines[y]
            if d > 0:
                if line:
                    self.lines[y] = unit + line
            elif line.startswith("\t"):
                self.lines[y] = line[1:]
            else:
                n = len(line) - len(line.lstrip(" "))
                self.lines[y] = line[min(n, TAB):]
        if self.anchor is not None:
            self.anchor = (self.anchor[0], 0)
            self.sticky = True

    def copy(self):
        r = self.sel_range()
        if r:
            self.app.set_clip(self.sel_text(r), False)
            self.anchor, self.sticky = None, False
            self.app.info("Kijelölés másolva")
        else:
            self.anchor = None
            self.app.set_clip(self.lines[self.cy], True)
            self.app.info("Sor másolva")

    def cut(self):
        r = self.sel_range()
        if r:
            self.push()
            self.app.set_clip(self.sel_text(r), False)
            self.delete_sel()
            self.modified = True
            return
        self.anchor = None
        self.push()
        self.modified = True
        line = self.lines.pop(self.cy)
        if not self.lines:
            self.lines.append("")
        text, linewise = self.app.clip
        if self.last_cut and linewise:
            self.app.set_clip(text + "\n" + line, True)
        else:
            self.app.set_clip(line, True)

    def paste(self):
        text, linewise = self.app.clip
        if not text and not linewise:
            self.app.info("A vágólap üres")
            return
        if linewise and self.anchor is None:
            self.begin()
            new = text.split("\n")
            self.lines[self.cy:self.cy] = new
            self.cy += len(new)
        else:
            self.replace_sel_begin(False)
            self.insert_text(text)

    # ---- fájl
    def save(self, path=None):
        path = path or self.path
        if not path:
            path = self.app.prompt("Mentés ide (fájlnév): ")
            if not path:
                return False
        path = os.path.expanduser(path)
        if not os.path.isabs(path):
            path = os.path.join(self.app.browser.cwd, path)
        try:
            save_text(path, self.lines, self.enc, self.nl, self.trailing)
        except OSError as e:
            self.app.error(f"Mentés sikertelen: {e.strerror or e}")
            return False
        if path != self.path:
            self.path = path
            self.set_syntax()
        self.modified = False
        self.typing = False
        self.app.info(f"Mentve: {os.path.basename(path)} ({len(self.lines)} sor)")
        return True

    def save_as(self):
        p = self.app.prompt("Mentés másként: ", self.path or "")
        if p:
            self.save(p)

    def confirm_discard(self):
        if not self.modified:
            return True
        a = self.app.ask("Mented a módosításokat? (i = igen, n = nem, Esc = mégse) ")
        if a in ("i", "y"):
            return self.save()
        return a == "n"

    def close(self, force=False):
        if force or self.confirm_discard():
            self.app.close_editor(self.path)

    # ---- keresés / csere
    def find_prompt(self):
        t = self.app.prompt("Keresés: ", self.search)
        if t is None:
            return
        self.search = t
        if t:
            self.find_from(self.cy, self.cx)

    def find_next(self):
        if not self.search:
            self.find_prompt()
        else:
            self.find_from(self.cy, self.cx + 1)

    def find_from(self, y, x):
        t = self.search.lower()
        n = len(self.lines)
        for i in range(n + 1):
            yy = (y + i) % n
            j = self.lines[yy].lower().find(t, x if i == 0 else 0)
            if j != -1:
                if (yy, j) < (y, x):
                    self.app.info("Körbeért, folytatás az elejéről")
                self.cy, self.cx = yy, j
                self.anchor = None
                self.set_want()
                self.center()
                return True
        self.app.error(f"Nincs találat: {self.search}")
        return False

    def center(self):
        th = self.app.text_height()
        if not (self.top <= self.cy < self.top + th):
            self.top = max(0, self.cy - th // 2)

    def replace_prompt(self):
        pat = self.app.prompt("Csere – mit (regex): ", self.search)
        if not pat:
            return
        rep = self.app.prompt(f"Csere – „{pat}” helyett: ")
        if rep is None:
            return
        y1, y2 = self.sel_lines(True)
        self.substitute(pat, rep, True, 0, y1, y2)

    def substitute(self, pat, rep, glob, flags, y1, y2):
        try:
            rx = re.compile(pat, flags)
        except re.error as e:
            self.app.error(f"Hibás regex: {e}")
            return
        new = self.lines[y1:y2 + 1]
        total = 0
        try:
            for i, line in enumerate(new):
                s, n = rx.subn(rep, line, count=0 if glob else 1)
                if n:
                    new[i] = s
                    total += n
        except (re.error, IndexError) as e:
            self.app.error(f"Hibás csere-minta: {e}")
            return
        if not total:
            self.app.error(f"Nincs találat: {pat}")
            return
        self.begin()
        self.lines[y1:y2 + 1] = "\n".join(new).split("\n")
        self.anchor = None
        self.clamp()
        self.app.info(f"{total} csere")

    def goto_prompt(self):
        s = self.app.prompt("Ugrás sorra (sor vagy sor:oszlop): ")
        if s:
            self.goto(s)

    def goto(self, s):
        m = re.fullmatch(r"\s*(\d+|\$)\s*(?::\s*(\d+))?\s*", s)
        if not m:
            self.app.error("Adj meg egy sorszámot, pl. 120 vagy 120:5")
            return
        self.cy = len(self.lines) - 1 if m.group(1) == "$" else int(m.group(1)) - 1
        self.clamp()
        self.cx = int(m.group(2)) - 1 if m.group(2) else 0
        self.anchor = None
        self.clamp()
        self.set_want()
        self.center()

    # ---- parancssor (vim ":")
    def run_command(self, cmd):
        app = self.app
        cmd = cmd.strip().lstrip(":").strip()
        if cmd in ("w", "write"):
            self.save()
        elif cmd.startswith("w ") or cmd.startswith("saveas "):
            self.save(cmd.split(None, 1)[1])
        elif cmd in ("q", "quit"):
            self.close()
        elif cmd == "q!":
            self.close(force=True)
        elif cmd in ("wq", "x"):
            if self.save():
                self.close(force=True)
        elif re.fullmatch(r"\d+|\$", cmd):
            self.goto(cmd)
        elif cmd in ("set nu", "set number"):
            self.numbers = True
        elif cmd in ("set nonu", "set nonumber"):
            self.numbers = False
        elif cmd in ("help", "h"):
            app.show_help(EDITOR_HELP_TEXT)
        elif cmd.startswith("@"):
            n = cmd[1:].strip()
            app.play_macro(int(n) if n.isdigit() else 1)
        elif cmd.startswith("e "):
            path = os.path.expanduser(cmd[2:].strip())
            if not os.path.isabs(path):
                path = os.path.join(self.dir(), path)
            if self.confirm_discard():
                app.open_editor(path)
        elif cmd in ("sort", "sort!", "uniq"):
            y1, y2 = self.sel_lines(True)
            part = self.lines[y1:y2 + 1]
            if cmd == "uniq":
                part = [l for i, l in enumerate(part) if i == 0 or l != part[i - 1]]
            else:
                part = sorted(part, key=str.casefold, reverse=cmd == "sort!")
            self.begin()
            self.lines[y1:y2 + 1] = part
            self.anchor = None
            app.info(f"{y2 - y1 + 1} sor feldolgozva")
        elif cmd in ("upper", "lower"):
            fn = str.upper if cmd == "upper" else str.lower
            r = self.sel_range()
            self.begin()
            if r:
                text = self.sel_text(r)
                self.delete_sel()
                self.insert_text(fn(text))
            else:
                self.lines[self.cy] = fn(self.lines[self.cy])
        elif cmd.startswith("r !") or cmd.startswith("r!"):
            out = self.shell_output(cmd.split("!", 1)[1], None)
            if out is not None:
                self.begin()
                lines = out.split("\n")
                self.lines[self.cy + 1:self.cy + 1] = lines
                app.info(f"{len(lines)} sor beszúrva")
        elif cmd.startswith("!"):
            sh = cmd[1:].strip()
            if self.sel_range():
                y1, y2 = self.sel_lines(False)
                out = self.shell_output(sh, "\n".join(self.lines[y1:y2 + 1]) + "\n")
                if out is not None:
                    self.begin()
                    self.lines[y1:y2 + 1] = out.split("\n")
                    self.anchor = None
                    self.cy, self.cx = y1, 0
            else:
                app.shell(sh, self.dir())
        elif self.try_substitute(cmd) or self.try_global(cmd):
            pass
        else:
            app.error(f"Ismeretlen parancs: {cmd}   (F1 = súgó)")
        self.clamp()

    def shell_output(self, sh, inp):
        try:
            p = subprocess.run(sh, shell=True, input=inp, capture_output=True,
                               text=True, cwd=self.dir(), timeout=120)
        except subprocess.TimeoutExpired:
            self.app.error("A parancs túl sokáig futott")
            return None
        if p.returncode != 0 and not p.stdout:
            err = (p.stderr.strip().splitlines() or ["hiba"])[-1]
            self.app.error(f"A parancs hibával tért vissza: {err}")
            return None
        out = p.stdout
        return out[:-1] if out.endswith("\n") else out

    def try_substitute(self, cmd):
        m = re.fullmatch(r"(%|(\d+|\$),(\d+|\$))?s([^\w\s\\])(.*)", cmd, re.S)
        if not m:
            return False
        parts = split_delim(m.group(5), m.group(4))
        pat = parts[0] or re.escape(self.search)
        rep = parts[1] if len(parts) > 1 else ""
        fl = parts[2] if len(parts) > 2 else ""
        last = len(self.lines)
        if m.group(1) == "%":
            y1, y2 = 0, last - 1
        elif m.group(2):
            conv = lambda v: last if v == "$" else int(v)
            y1, y2 = conv(m.group(2)) - 1, conv(m.group(3)) - 1
            y1, y2 = max(0, min(y1, y2)), min(last - 1, max(y1, y2))
        else:
            y1, y2 = self.sel_lines(False)
        if not pat:
            self.app.error("Üres keresési minta")
            return True
        self.substitute(pat, rep, "g" in fl, re.I if "i" in fl else 0, y1, y2)
        return True

    def try_global(self, cmd):
        if len(cmd) < 3 or cmd[0] not in "gv" or cmd[1].isalnum() or cmd[1].isspace():
            return False
        parts = split_delim(cmd[2:], cmd[1])
        if len(parts) < 2 or parts[1].strip() != "d":
            self.app.error("Formátum: g/minta/d vagy v/minta/d")
            return True
        try:
            rx = re.compile(parts[0])
        except re.error as e:
            self.app.error(f"Hibás regex: {e}")
            return True
        keep_match = cmd[0] == "v"
        y1, y2 = self.sel_lines(True)
        part = self.lines[y1:y2 + 1]
        kept = [l for l in part if bool(rx.search(l)) == keep_match]
        removed = len(part) - len(kept)
        if removed:
            self.begin()
            self.lines[y1:y2 + 1] = kept
            if not self.lines:
                self.lines = [""]
            self.anchor = None
        self.app.info(f"{removed} sor törölve")
        return True

    # ---- rajzolás
    def draw(self, scr, h, w):
        th = h - 4
        L = self.lines
        gutter = len(str(len(L))) + 1 if self.numbers else 0
        tw = max(1, w - gutter)
        if self.cy < self.top:
            self.top = self.cy
        elif self.cy >= self.top + th:
            self.top = self.cy - th + 1
        dc = disp_col(L[self.cy], self.cx)
        if dc < self.left:
            self.left = dc
        elif dc >= self.left + tw:
            self.left = dc - tw + 1
        sel = self.sel_range()
        term = self.search.lower()
        for r in range(th):
            y = self.top + r
            row = 1 + r
            if y >= len(L):
                put(scr, row, 0, "~", A["ln"])
                continue
            if self.numbers:
                put(scr, row, 0, f"{y + 1:>{gutter - 1}} ", A["ln"])
            line = L[y]
            attrs = highlight(line, self.ctok) if self.hl else [0] * len(line)
            if term:
                low = line.lower()
                j = low.find(term)
                while j != -1:
                    for i in range(j, min(j + len(term), len(attrs))):
                        attrs[i] = A["match"]
                    j = low.find(term, j + len(term))
            if sel and sel[0][0] <= y <= sel[1][0]:
                s = sel[0][1] if y == sel[0][0] else 0
                e = sel[1][1] if y == sel[1][0] else len(line)
                for i in range(s, e):
                    attrs[i] = curses.A_REVERSE
            cells = []
            for ch, at in zip(line, attrs):
                if ch == "\t":
                    cells += [(" ", at)] * (TAB - len(cells) % TAB)
                else:
                    cells.append((ch if ch >= " " else "·", at))
                if len(cells) > self.left + tw:
                    break
            cells = cells[self.left:self.left + tw]
            x = gutter
            i = 0
            while i < len(cells):
                at = cells[i][1]
                j = i
                while j < len(cells) and cells[j][1] == at:
                    j += 1
                put(scr, row, x, "".join(c for c, _ in cells[i:j]), at)
                x += j - i
                i = j
            if sel and sel[0][0] <= y < sel[1][0] and len(cells) < tw and \
                    disp_col(line, len(line)) >= self.left:
                put(scr, row, x, " ", curses.A_REVERSE)
        name = self.path or "[új fájl]"
        if self.path and self.path.startswith(os.path.expanduser("~")):
            name = "~" + self.path[len(os.path.expanduser("~")):]
        left = f" nanger │ {name}{'  [módosítva]' if self.modified else ''}"
        right = (("● FELVÉTEL  " if self.app.recording is not None else "") +
                 f"{self.cy + 1}:{self.cx + 1}  {len(L)} sor  {self.enc} ")
        put(scr, 0, 0, " " * w, A["title"])
        put(scr, 0, 0, left[: max(0, w - len(right) - 1)], A["title"])
        put(scr, 0, max(0, w - len(right)), right, A["title"])
        draw_help(scr, h - 2, EDITOR_HELP1, w)
        draw_help(scr, h - 1, EDITOR_HELP2, w)
        return (1 + self.cy - self.top, gutter + dc - self.left)


# ---------------------------------------------------------- képek, PDF, archívumok

IMAGE_EXT = {".png", ".jpg", ".jpeg", ".jfif", ".gif", ".bmp", ".webp", ".tif", ".tiff",
             ".ico", ".ppm", ".pgm", ".pbm"}
ARCHIVE_EXT = (".zip", ".jar", ".whl", ".apk", ".tar", ".tar.gz", ".tgz", ".tar.bz2",
               ".tbz2", ".tar.xz", ".txz")
EXTERNAL_EXT = {".docx", ".xlsx", ".pptx", ".odt", ".ods", ".odp", ".doc", ".xls", ".ppt",
                ".rtf", ".epub", ".mp3", ".mp4", ".mkv", ".avi", ".mov", ".webm", ".flac",
                ".ogg", ".wav", ".m4a", ".opus"}
_CUBE = (0, 95, 135, 175, 215, 255)
_RENDER_CACHE = OrderedDict()
_PAIRS = {}


def file_kind(p):
    """dir | pdf | image | archive | external | text | binary"""
    if os.path.isdir(p):
        return "dir"
    low = p.lower()
    ext = os.path.splitext(low)[1]
    if ext == ".pdf":
        return "pdf"
    if ext in IMAGE_EXT:
        return "image"
    if ext in EXTERNAL_EXT:
        return "external"
    if low.endswith(ARCHIVE_EXT):
        return "archive"
    try:
        with open(p, "rb") as f:
            head = f.read(8192)
    except OSError:
        return "binary"
    return "binary" if b"\0" in head else "text"


def has_gui():
    return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) \
        and shutil.which("xdg-open") is not None


def is_utf8():
    return "utf" in (locale.getpreferredencoding(False) or "").lower()


@functools.lru_cache(maxsize=1 << 16)
def rgb_to_256(r, g, b):
    def lv(c):
        return 0 if c < 48 else 1 if c < 115 else (c - 35) // 40

    ri, gi, bi = lv(r), lv(g), lv(b)
    avg = (r + g + b) // 3
    gl = 23 if avg > 238 else max(0, (avg - 3) // 10)
    gv = 8 + 10 * gl
    d_cube = (_CUBE[ri] - r) ** 2 + (_CUBE[gi] - g) ** 2 + (_CUBE[bi] - b) ** 2
    d_gray = (gv - r) ** 2 + (gv - g) ** 2 + (gv - b) ** 2
    return 232 + gl if d_gray < d_cube else 16 + 36 * ri + 6 * gi + bi


def quant(px):
    r, g, b = px[:3]
    if curses.COLORS >= 256:
        return rgb_to_256(r, g, b)
    return int(r > 127) | int(g > 127) << 1 | int(b > 127) << 2


def render_grid(img, cols, rows):
    """PIL-kép → félblokkos cellák: soronként (felső szín, alsó szín) párok."""
    rs = getattr(Image, "Resampling", Image)
    img = img.convert("RGBA")
    if img.getchannel("A").getextrema()[0] < 255:
        img = Image.alpha_composite(Image.new("RGBA", img.size, (0, 0, 0, 255)), img)
    img = img.convert("RGB")
    w, h = img.size
    scale = min(cols / w, rows * 2 / h)
    nw, nh = max(1, int(w * scale)), max(1, int(h * scale))
    nh += nh % 2
    method = rs.LANCZOS if scale < 1 else (rs.NEAREST if scale >= 2 else rs.BILINEAR)
    px = img.resize((nw, nh), method).load()
    return [[(quant(px[x, y]), quant(px[x, y + 1])) for x in range(nw)]
            for y in range(0, nh, 2)]


def color_attr(fg, bg):
    key = (fg, bg)
    a = _PAIRS.get(key)
    if a is None:
        n = 10 + len(_PAIRS)
        if n >= curses.COLOR_PAIRS:
            return 0
        curses.init_pair(n, fg, bg)
        a = _PAIRS[key] = curses.color_pair(n)
    return a


def draw_grid(scr, y0, x0, grid):
    h, w = scr.getmaxyx()
    for r, row in enumerate(grid):
        y = y0 + r
        if y >= h:
            break
        for c, (fg, bg) in enumerate(row):
            if x0 + c >= w:
                break
            try:
                scr.addstr(y, x0 + c, "▀", color_attr(fg, bg))
            except curses.error:
                pass


@functools.lru_cache(maxsize=64)
def pdf_pages(path, mtime):
    try:
        out = subprocess.run(["pdfinfo", path], capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return 0
    m = re.search(r"^Pages:\s+(\d+)", out, re.M)
    return int(m.group(1)) if m else 0


@functools.lru_cache(maxsize=32)
def pdf_text(path, mtime, page):
    exe = shutil.which("pdftotext")
    if not exe:
        raise RuntimeError("nincs pdftotext (poppler-utils)")
    r = subprocess.run([exe, "-f", str(page), "-l", str(page), "-layout", path, "-"],
                       capture_output=True, timeout=20)
    if r.returncode != 0:
        msg = r.stderr.decode("utf-8", "replace").strip().splitlines()
        raise RuntimeError(msg[-1] if msg else "a PDF szövege nem olvasható")
    return r.stdout.decode("utf-8", "replace").replace("\f", "")


def pdf_page_image(path, page, px):
    exe = shutil.which("pdftoppm")
    if not exe:
        raise RuntimeError("nincs pdftoppm (poppler-utils)")
    # ideiglenes fájlba renderelünk: a stdout-ra írás nem minden poppler-verzióban megy
    with tempfile.TemporaryDirectory(prefix="nanger-") as tmp:
        root = os.path.join(tmp, "page")
        r = subprocess.run([exe, "-png", "-singlefile", "-f", str(page), "-l", str(page),
                            "-scale-to-x", str(px), "-scale-to-y", "-1", path, root],
                           capture_output=True, timeout=20)
        if r.returncode != 0 or not os.path.exists(root + ".png"):
            msg = r.stderr.decode("utf-8", "replace").strip().splitlines()
            raise RuntimeError(msg[-1] if msg else "a PDF nem jeleníthető meg")
        with open(root + ".png", "rb") as f:
            img = Image.open(io.BytesIO(f.read()))
            img.load()
    return img


def cached_render(kind, path, page, cols, rows, lazy=False):
    """(cellák, felirat) — lazy=True esetén None, ha még nincs a gyorsítótárban."""
    st = os.stat(path)
    key = (kind, path, st.st_mtime_ns, st.st_size, page, cols, rows)
    hit = _RENDER_CACHE.get(key)
    if hit is not None:
        _RENDER_CACHE.move_to_end(key)
        return hit
    if lazy:
        return None
    if Image is None:
        raise RuntimeError("képekhez kell a Pillow (python3-pil / python-pillow)")
    if kind == "pdf":
        img = pdf_page_image(path, page, min(2400, max(300, cols * 4)))
        pages = pdf_pages(path, st.st_mtime_ns)
        caption = f"PDF  {page}/{pages} oldal" if pages else "PDF"
    else:
        img = Image.open(path)
        caption = f"{img.format or 'kép'}  {img.width}×{img.height}"
        img.draft("RGB", (cols * 4, rows * 8))
    res = (render_grid(img, cols, rows), caption)
    _RENDER_CACHE[key] = res
    while len(_RENDER_CACHE) > 12:
        _RENDER_CACHE.popitem(last=False)
    return res


def archive_lines(p, limit):
    """[(szöveg, attribútum)], van-e még több elem"""
    out, more = [], False
    try:
        if p.lower().endswith((".zip", ".jar", ".whl", ".apk")):
            with zipfile.ZipFile(p) as z:
                infos = z.infolist()
                more = len(infos) > limit
                for zi in infos[:limit]:
                    size = "" if zi.is_dir() else human(zi.file_size)
                    out.append((f"{size:>7}  {clean(zi.filename)}", 0))
        else:
            with tarfile.open(p) as t:
                for m in t:
                    if len(out) >= limit:
                        more = True
                        break
                    size = "" if m.isdir() else human(m.size)
                    out.append((f"{size:>7}  {clean(m.name)}{'/' if m.isdir() else ''}", 0))
    except (OSError, EOFError, zipfile.BadZipFile, tarfile.TarError) as e:
        return [(f"[az archívum nem olvasható: {e}]", A["err"])], False
    if not out:
        out = [("(üres archívum)", A["ln"])]
    return out, more


def trash_dir():
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"),
                                                           ".local", "share")
    return os.path.join(base, "Trash")


def move_to_trash(path):
    """Szabványos (freedesktop.org) kuka a saját mappában."""
    path = os.path.abspath(path)
    files = os.path.join(trash_dir(), "files")
    infos = os.path.join(trash_dir(), "info")
    os.makedirs(files, mode=0o700, exist_ok=True)
    os.makedirs(infos, mode=0o700, exist_ok=True)
    name = os.path.basename(path)
    dest, i = os.path.join(files, name), 1
    while os.path.lexists(dest) or os.path.lexists(os.path.join(infos, os.path.basename(dest) + ".trashinfo")):
        i += 1
        dest = os.path.join(files, f"{name}.{i}")
    info = os.path.join(infos, os.path.basename(dest) + ".trashinfo")
    with open(info, "w", encoding="utf-8") as f:
        f.write("[Trash Info]\nPath=%s\nDeletionDate=%s\n"
                % (quote(path), time.strftime("%Y-%m-%dT%H:%M:%S")))
    try:
        shutil.move(path, dest)
    except BaseException:
        try:
            os.unlink(info)
        except OSError:
            pass
        raise


def trash(path):
    """Kukába teszi; másik köteten lévő fájlt a gio-ra bízza, ha van."""
    try:
        other_disk = os.lstat(path).st_dev != os.stat(os.path.expanduser("~")).st_dev
    except OSError:
        other_disk = False
    if other_disk and shutil.which("gio"):
        r = subprocess.run(["gio", "trash", "--", os.path.abspath(path)],
                           capture_output=True, timeout=120)
        if r.returncode == 0:
            return
    move_to_trash(path)


